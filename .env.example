POSTGRES_DB=kieumai_notifier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-bytes

# Host ports; PostgreSQL inside Docker always listens on 5432.
POSTGRES_PORT=5434
APP_PORT=8080

# Used by compose.ghcr.yaml after the image has been published.
APP_IMAGE=ghcr.io/phatcaoduc2910/kieumainotifier:latest
